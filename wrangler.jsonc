{
  "name": "sfe5",
  "compatibility_date": "2025-01-01",
  // worker.js runs ONLY for /assets/* (see run_worker_first): it converts the SPA fallback for
  // missing hashed bundles into a real 404 so stale clients can't cache HTML-as-JS immutably.
  "main": "worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/*"]
  }
}
